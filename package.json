    "python/",
    "skill/",
    "cordis.patch.yml",
    "CONTRACT.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "UNLICENSED",
